{
  "name": "ticketing-system",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev --workspace=client\" \"npm run start --workspace=server\"",
    "build": "npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "migrate": "npm run migrate --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
